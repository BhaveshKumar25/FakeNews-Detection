# FakeNews AI Configuration Example
# Copy this file to .env and customize as needed.

# Google Fact Check Tools API Key (Optional)
# Obtain a free key from Google Cloud Console: https://console.cloud.google.com/
FACT_CHECK_API_KEY=

# Uncertainty Threshold (0.50 to 0.90, default is 0.65)
# Predictions with confidence below this threshold trigger a verification advisory.
UNCERTAINTY_THRESHOLD=0.65

# Custom Tesseract OCR Binary Path (Optional on Windows if not in PATH)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Request timeout in seconds for URL extraction and external queries
REQUEST_TIMEOUT_SECONDS=6
